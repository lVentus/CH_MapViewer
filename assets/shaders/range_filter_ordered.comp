#version 430 core

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer OrderedRanges {
    uvec2 ranges[];
};

layout(std430, binding = 1) readonly buffer ScanEnds {
    uint scanEndByLevel[];
};

layout(std430, binding = 2) writeonly buffer VisibleEdges {
    uint visibleEdgeIds[];
};

layout(std430, binding = 3) buffer DrawCommand {
    uint count;
    uint instanceCount;
    uint first;
    uint baseInstance;
} command;

uniform int uLevel;
uniform uint uLevelCount;

shared uint localCount;
shared uint globalBase;

void main() {
    uint localIndex = gl_LocalInvocationID.x;
    if (localIndex == 0u) {
        localCount = 0u;
        globalBase = 0u;
    }
    barrier();

    if (uLevel < 0 || uint(uLevel) >= uLevelCount) {
        return;
    }

    uint candidateCount = scanEndByLevel[uint(uLevel)];
    uint rangeIndex = gl_GlobalInvocationID.x;
    bool alive = rangeIndex < candidateCount && ranges[rangeIndex].y <= uint(uLevel);

    uint groupOffset = 0u;
    uint edgeId = 0u;
    if (alive) {
        edgeId = ranges[rangeIndex].x;
        groupOffset = atomicAdd(localCount, 1u);
    }
    barrier();

    if (localIndex == 0u && localCount != 0u) {
        globalBase = atomicAdd(command.count, localCount * 2u) >> 1u;
    }
    barrier();

    if (alive) {
        visibleEdgeIds[globalBase + groupOffset] = edgeId;
    }
}
