#version 430 core

layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer ScanEnds {
    uint scanEndByLevel[];
};

layout(std430, binding = 1) buffer DispatchCommand {
    uint groupsX;
    uint groupsY;
    uint groupsZ;
} dispatchCommand;

uniform int uLevel;
uniform uint uLevelCount;

const uint WorkGroupSize = 256u;

void main() {
    uint candidateCount = 0u;
    if (uLevel >= 0 && uint(uLevel) < uLevelCount) {
        candidateCount = scanEndByLevel[uint(uLevel)];
    }

    dispatchCommand.groupsX = (candidateCount + WorkGroupSize - 1u) / WorkGroupSize;
    dispatchCommand.groupsY = 1u;
    dispatchCommand.groupsZ = 1u;
}
