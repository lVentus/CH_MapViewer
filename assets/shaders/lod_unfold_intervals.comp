#version 430 core

// Expansion without traversal: every candidate decides on its own from its two level intervals
// and its error interval. With uChildIntervals = 0 only roots are drawn (no expansion);
// otherwise this is the dual-interval rule of LodPageFormat.h, which gives exactly the cut a
// traversal would find. The chord is only read for segments that are drawn, to cull them.

layout(local_size_x = 256) in;

#include "lod_page_common.glsl"
#include "lod_page_segments.glsl"

layout(std430, binding = 2) readonly buffer Candidates {
    uint candidateCount;
    uint candidateGroups[3];
    uint candidates[];
};

uniform uint uLevel;
uniform uint uThreshold;
uniform uint uChildIntervals;

void main() {
    uint index = linearInvocation();
    bool draw = false;
    uint item = 0u;
    if (index < candidateCount) {
        item = candidates[index];
        uvec4 record = pageRecord(item);
        uint errorCode = record.w & 0xffffu;
        uint parentCode = record.w >> 16u;
        bool asChild = uChildIntervals != 0u && inLevelRange(record.z, uLevel) &&
                       uThreshold < parentCode;
        draw = errorCode <= uThreshold && (inLevelRange(record.y, uLevel) || asChild) &&
               keepDrawn(item, record);
    }
    drawSegments(draw, item);
}
