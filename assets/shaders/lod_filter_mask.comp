#version 430 core

// Two-pass filter, step 1: one workgroup per listed page tests each record once and keeps the
// outcome as a 256-bit mask per page, plus the number of matches (lod_filter_offsets.comp turns
// those into offsets). Step 3 then only reads the masks, not the records.

layout(local_size_x = 256) in;

#include "lod_page_common.glsl"

layout(std430, binding = 2) readonly buffer SlotList {
    uint slotCount;
    uint slotGroups[3];
    uint slots[];
};
// Eight words per listed page.
layout(std430, binding = 5) writeonly buffer Masks { uint masks[]; };
// [total, groupsX, groupsY, groupsZ, then one count (later offset) per listed page]
layout(std430, binding = 6) writeonly buffer Prefix {
    uint prefixTotal;
    uint prefixGroups[3];
    uint prefix[];
};

uniform uint uLevel;

shared uint sMask[8];

void main() {
    uint index = linearGroup();
    uint local = gl_LocalInvocationID.x;
    if (local < 8u) {
        sMask[local] = 0u;
    }
    barrier();
    if (index < slotCount) {
        uint slot = slots[index];
        if (local < recordCount(slot) && levelMatch(pageRecord((slot << 8u) | local), uLevel)) {
            atomicOr(sMask[local >> 5u], 1u << (local & 31u));
        }
    }
    barrier();
    if (index >= slotCount) {
        return;
    }
    if (local < 8u) {
        masks[index * 8u + local] = sMask[local];
    }
    if (local == 0u) {
        uint count = 0u;
        for (uint word = 0u; word < 8u; ++word) {
            count += uint(bitCount(sMask[word]));
        }
        prefix[index] = count;
    }
}
