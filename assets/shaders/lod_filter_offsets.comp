#version 430 core

// Birth-ordered filter, step 2: one workgroup turns the per-page counts into offsets (exclusive
// prefix sum, in place) and writes the total.

layout(local_size_x = 1024) in;

layout(std430, binding = 2) readonly buffer SlotList {
    uint slotCount;
    uint slotGroups[3];
    uint slots[];
};
layout(std430, binding = 6) buffer Prefix {
    uint prefixTotal;
    uint prefixGroups[3];
    uint prefix[];
};

shared uint sSums[1024];

void main() {
    uint local = gl_LocalInvocationID.x;
    uint chunk = (slotCount + 1023u) / 1024u;
    uint begin = min(local * chunk, slotCount);
    uint end = min(begin + chunk, slotCount);

    uint sum = 0u;
    for (uint i = begin; i < end; ++i) {
        sum += prefix[i];
    }
    sSums[local] = sum;
    barrier();

    // Inclusive scan of the chunk sums (Hillis-Steele).
    for (uint stride = 1u; stride < 1024u; stride <<= 1u) {
        uint add = local >= stride ? sSums[local - stride] : 0u;
        barrier();
        sSums[local] += add;
        barrier();
    }

    uint offset = sSums[local] - sum;
    for (uint i = begin; i < end; ++i) {
        uint count = prefix[i];
        prefix[i] = offset;
        offset += count;
    }
    if (local == 1023u) {
        prefixTotal = sSums[1023];
    }
}
