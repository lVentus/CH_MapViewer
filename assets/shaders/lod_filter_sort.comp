#version 430 core

// Birth-ordered filter, preparation: sorts the records of newly uploaded pages by the highest
// level at which they can still be drawn, descending (a bitonic sort in shared memory, one
// workgroup per page), so that the records of a level form a prefix of that order. The order is
// stored as one byte per record, 64 words per slot.

layout(local_size_x = 256) in;

#include "lod_page_common.glsl"

layout(std430, binding = 2) readonly buffer SortList {
    uint sortCount;
    uint sortGroups[3];
    uint sortSlots[];
};
layout(std430, binding = 5) buffer Order { uint order[]; };

shared uint sKeys[256];

void main() {
    uint index = linearGroup();
    uint local = gl_LocalInvocationID.x;
    bool sorting = index < sortCount;
    uint slot = sorting ? sortSlots[index] : 0u;

    uint key = 0u;
    if (sorting && local < recordCount(slot)) {
        uvec4 record = pageRecord((slot << 8u) | local);
        uint highest = max(record.y >> 16u, record.z >> 16u);
        key = ((highest + 1u) << 8u) | local;
    }
    sKeys[local] = key;
    barrier();

    for (uint size = 2u; size <= 256u; size <<= 1u) {
        for (uint stride = size >> 1u; stride > 0u; stride >>= 1u) {
            uint partner = local ^ stride;
            if (partner > local) {
                uint mine = sKeys[local];
                uint theirs = sKeys[partner];
                bool descending = (local & size) == 0u;
                if ((mine < theirs) == descending) {
                    sKeys[local] = theirs;
                    sKeys[partner] = mine;
                }
            }
            barrier();
        }
    }

    if (sorting && local < 64u) {
        uint word = 0u;
        for (uint k = 0u; k < 4u; ++k) {
            word |= (sKeys[local * 4u + k] & 0xffu) << (8u * k);
        }
        order[slot * 64u + local] = word;
    }
}
