#version 430 core

// Persistent queue, preparation: empties the queue counters, takes the candidates as seeds and
// sizes the grid of resident workgroups from them (at least uMinGroups, so that a few roots with
// deep subtrees still get spread, at most uMaxGroups, so that idle invocations do not crowd the
// queue counters).

layout(local_size_x = 1) in;

layout(std430, binding = 2) readonly buffer Candidates { uint candidateCount; };
layout(std430, binding = 7) buffer Queue {
    uint queueHead;
    uint queueTail;
    uint queuePending;
    uint queueSeeds;
    uint queueGroups[4];
};

uniform uint uCandidateCapacity;
uniform uint uGroupSize;
uniform uint uMinGroups;
uniform uint uMaxGroups;

void main() {
    uint seeds = min(candidateCount, uCandidateCapacity);
    queueHead = 0u;
    queueTail = 0u;
    queuePending = seeds;
    queueSeeds = seeds;
    queueGroups[0] = seeds == 0u ? 0u
                                 : clamp((seeds + uGroupSize - 1u) / uGroupSize, uMinGroups,
                                         uMaxGroups);
    queueGroups[1] = 1u;
    queueGroups[2] = 1u;
}
