#version 430 core

layout(local_size_x = 256) in;

struct Edge {
    uvec4 topology;
    ivec4 levels;
};

layout(std430, binding = 0) readonly buffer Edges {
    Edge edges[];
};

layout(std430, binding = 1) readonly buffer InputEdges {
    uint inputEdgeIds[];
};

layout(std430, binding = 2) readonly buffer InputDrawCommand {
    uint inputVertexCount;
    uint inputInstanceCount;
    uint inputFirst;
    uint inputBaseInstance;
};

layout(std430, binding = 3) writeonly buffer OutputEdges {
    uint outputEdgeIds[];
};

layout(std430, binding = 4) buffer OutputCounter {
    uint outputEdgeCount;
};

layout(std430, binding = 5) buffer Status {
    uint stackOverflowCount;
    uint outputOverflowCount;
};

uniform uint uEdgeCount;
uniform uint uOutputCapacity;

const uint InvalidEdgeId = 0xffffffffu;
const int MaxStackSize = 64;

void EmitEdge(uint edgeId) {
    uint outputIndex = atomicAdd(outputEdgeCount, 1u);
    if (outputIndex < uOutputCapacity) {
        outputEdgeIds[outputIndex] = edgeId;
    } else {
        atomicAdd(outputOverflowCount, 1u);
    }
}

void main() {
    uint inputIndex = gl_GlobalInvocationID.x;
    uint inputEdgeCount = inputVertexCount >> 1u;
    if (inputIndex >= inputEdgeCount) {
        return;
    }

    uint stack[MaxStackSize];
    int stackSize = 1;
    stack[0] = inputEdgeIds[inputIndex];

    while (stackSize > 0) {
        uint edgeId = stack[--stackSize];
        if (edgeId >= uEdgeCount) {
            continue;
        }

        Edge edge = edges[edgeId];
        uint childA = edge.topology.z;
        uint childB = edge.topology.w;
        bool shortcut = childA != InvalidEdgeId && childB != InvalidEdgeId;

        if (!shortcut) {
            EmitEdge(edgeId);
            continue;
        }

        if (stackSize > MaxStackSize - 2) {
            atomicAdd(stackOverflowCount, 1u);
            EmitEdge(edgeId);
            continue;
        }

        stack[stackSize++] = childB;
        stack[stackSize++] = childA;
    }
}
