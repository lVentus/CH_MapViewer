#version 430 core

// Turns the segment count of the expansion pass into the vertex count of the indirect draw,
// dropping (and counting) segments beyond the capacity.

layout(local_size_x = 1) in;

layout(std430, binding = 4) buffer Status { uint status[]; };
layout(std430, binding = 5) buffer DrawCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint baseInstance;
    uint segmentCount;
};

uniform uint uSegmentCapacity;

void main() {
    if (segmentCount > uSegmentCapacity) {
        status[1] = segmentCount - uSegmentCapacity;
        segmentCount = uSegmentCapacity;
    }
    vertexCount = segmentCount * 6u;
}
